VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Company sign-on (Google Workspace).
#
# Leave this off until the provider is actually enabled on the backend.
# While it is off the login screen shows email and password only — a sign-in
# button for a provider that is switched off just returns an error (QA-38).
#
# On the day it is switched on, set this to true AND set
# organizations.sso_enabled, so new joiners are marked as SSO users.
VITE_SSO_ENABLED=false

# The address people actually reach Pulse at, used for links we send to
# others — set-password invitations and alumni reactivation.
#
# Without this, links are built from whatever the person generating them is
# browsing, which is http://localhost:5173 in development. The link looks
# perfectly normal and reaches nobody. Set this before inviting anybody real.
VITE_PUBLIC_APP_URL=https://pulse.augustinnovate.com
